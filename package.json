{
  "name": "tempo_chess",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:api": "cd server && node --env-file=.env --import tsx src/index.ts",
    "dev:all": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@supabase/supabase-js": "^2.110.5",
    "chess.js": "^1.4.0",
    "chessops": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
