{
  "$comment": "Generated by npm run deploy:render from server/src/platform/topology.ts. Do not edit.",
  "project": "tempo-chess-neri",
  "region": "europe-west1",
  "connectionBudget": {
    "availableToServices": 42
  },
  "services": [
    {
      "name": "forma-api",
      "ingress": "all",
      "allowUnauthenticated": true,
      "serviceAccount": "forma-api@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_api",
      "databaseSecret": "forma-api-db-url",
      "audience": "forma-api",
      "urlEnv": "FORMA_API_URL",
      "capabilities": [
        "serve_public_requests"
      ],
      "executes": [],
      "maxInstances": 6,
      "containerConcurrency": 40,
      "poolSize": 3,
      "peakConnections": 18,
      "cpu": "1",
      "memory": "1Gi",
      "timeoutSeconds": 30
    },
    {
      "name": "forma-ops",
      "ingress": "internal",
      "allowUnauthenticated": false,
      "serviceAccount": "forma-ops@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_ops",
      "databaseSecret": "forma-ops-db-url",
      "audience": "forma-ops",
      "urlEnv": "FORMA_OPS_URL",
      "capabilities": [
        "dispatch_outbox"
      ],
      "executes": [
        "api_light"
      ],
      "maxInstances": 2,
      "containerConcurrency": 2,
      "poolSize": 2,
      "peakConnections": 4,
      "cpu": "1",
      "memory": "512Mi",
      "timeoutSeconds": 300
    },
    {
      "name": "forma-ingestion",
      "ingress": "internal",
      "allowUnauthenticated": false,
      "serviceAccount": "forma-ingestion@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_ingestion",
      "databaseSecret": "forma-ingestion-db-url",
      "audience": "forma-ingestion",
      "urlEnv": "FORMA_INGESTION_URL",
      "capabilities": [
        "provider_traffic"
      ],
      "executes": [
        "ingestion"
      ],
      "maxInstances": 4,
      "containerConcurrency": 1,
      "poolSize": 2,
      "peakConnections": 8,
      "cpu": "1",
      "memory": "1Gi",
      "timeoutSeconds": 900
    },
    {
      "name": "forma-stockfish",
      "ingress": "internal",
      "allowUnauthenticated": false,
      "serviceAccount": "forma-stockfish@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_stockfish",
      "databaseSecret": "forma-stockfish-db-url",
      "audience": "forma-stockfish",
      "urlEnv": "FORMA_STOCKFISH_URL",
      "capabilities": [
        "engine_analysis"
      ],
      "executes": [
        "cpu_engine"
      ],
      "maxInstances": 6,
      "containerConcurrency": 1,
      "poolSize": 1,
      "peakConnections": 6,
      "cpu": "2",
      "memory": "2Gi",
      "timeoutSeconds": 900
    },
    {
      "name": "forma-analysis",
      "ingress": "internal",
      "allowUnauthenticated": false,
      "serviceAccount": "forma-analysis@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_analysis",
      "databaseSecret": "forma-analysis-db-url",
      "audience": "forma-analysis",
      "urlEnv": "FORMA_ANALYSIS_URL",
      "capabilities": [
        "model_inference"
      ],
      "executes": [
        "cpu_model",
        "aggregation",
        "publication"
      ],
      "maxInstances": 3,
      "containerConcurrency": 2,
      "poolSize": 2,
      "peakConnections": 6,
      "cpu": "2",
      "memory": "2Gi",
      "timeoutSeconds": 900
    }
  ],
  "queues": [
    {
      "name": "provider-lichess",
      "target": "forma-ingestion",
      "maxConcurrentDispatches": 1,
      "maxDispatchesPerSecond": 1,
      "maxAttempts": 5
    },
    {
      "name": "provider-chesscom",
      "target": "forma-ingestion",
      "maxConcurrentDispatches": 2,
      "maxDispatchesPerSecond": 2,
      "maxAttempts": 5
    },
    {
      "name": "stockfish-screen",
      "target": "forma-stockfish",
      "maxConcurrentDispatches": 4,
      "maxDispatchesPerSecond": 4,
      "maxAttempts": 5
    },
    {
      "name": "stockfish-deep",
      "target": "forma-stockfish",
      "maxConcurrentDispatches": 2,
      "maxDispatchesPerSecond": 2,
      "maxAttempts": 3
    },
    {
      "name": "analysis",
      "target": "forma-analysis",
      "maxConcurrentDispatches": 4,
      "maxDispatchesPerSecond": 4,
      "maxAttempts": 5
    },
    {
      "name": "maintenance",
      "target": "forma-analysis",
      "maxConcurrentDispatches": 2,
      "maxDispatchesPerSecond": 1,
      "maxAttempts": 3
    }
  ],
  "schedules": [
    {
      "name": "forma-dispatch-outbox",
      "target": "forma-ops",
      "path": "/internal/ops/dispatch",
      "schedule": "* * * * *",
      "purpose": "Publish committed outbox events to Cloud Tasks and enqueue due account syncs.",
      "oidcServiceAccount": "forma-scheduler@tempo-chess-neri.iam.gserviceaccount.com"
    },
    {
      "name": "forma-recover-leases",
      "target": "forma-ops",
      "path": "/internal/ops/recover",
      "schedule": "*/5 * * * *",
      "purpose": "Recover expired leases and reconcile the queue against the work ledger.",
      "oidcServiceAccount": "forma-scheduler@tempo-chess-neri.iam.gserviceaccount.com"
    }
  ],
  "jobs": [
    {
      "name": "forma-migrate",
      "serviceAccount": "forma-migrator@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_migrator",
      "command": "node dist/ops/migrate.js",
      "purpose": "Apply and verify additive migrations from an immutable image.",
      "maxRetries": 0,
      "timeoutSeconds": 1800
    },
    {
      "name": "forma-promote",
      "serviceAccount": "forma-analysis@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_analysis",
      "command": "node dist/analysis/promote.js",
      "purpose": "Register the analysis method, validate it against the committed corpus, and promote it.",
      "maxRetries": 0,
      "timeoutSeconds": 1800
    },
    {
      "name": "forma-reconcile",
      "serviceAccount": "forma-ops@tempo-chess-neri.iam.gserviceaccount.com",
      "databaseRole": "forma_ops",
      "command": "node dist/ops/reconcile-report.js",
      "purpose": "Additive backfill and queue/ledger reconciliation, resumable by checkpoint.",
      "maxRetries": 2,
      "timeoutSeconds": 3600
    }
  ]
}
