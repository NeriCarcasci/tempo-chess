# Tempo Chess web (Cloudflare Pages / Vite) — copy to .env for local dev.
# Only VITE_-prefixed vars are exposed to the browser, so keep this to public values.

# Base URL of the Cloud Run API (no trailing slash).
VITE_API_URL=http://localhost:8787

# Supabase public (safe-to-expose) values for client-side auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
