# Tempo Chess web (Cloudflare Pages / Vite) — copy to .env for local dev.
# Only VITE_-prefixed vars are exposed to the browser, so keep this to public values.

# Base URL of the Cloud Run API (no trailing slash).
# The app reads VITE_ENGINE_URL first, then falls back to VITE_API_URL.
VITE_ENGINE_URL=http://localhost:8787

# Supabase public (safe-to-expose) values for client-side auth.
# Project settings → API. Either the legacy anon JWT or a new sb_publishable_ key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side (server/.env) — never expose these to the browser.
# ---------------------------------------------------------------------------
# SUPABASE_URL=            # same project URL as above
# SUPABASE_ANON_KEY=       # used to verify caller access tokens
# DATABASE_URL=            # Supabase session-pooler connection string
# WEB_ORIGIN=              # the SPA origin, for CORS in production

# Billing (Stripe). Everything works without these — the API reports
# `configured: false` and the UI says billing isn't live yet. Fill them in and
# implement the two stubs in server/src/billing/service.ts to go live.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
