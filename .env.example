# Forma web (Cloudflare Pages / Vite) — copy to .env for local dev.
# Only VITE_-prefixed vars are exposed to the browser, so keep this to public values.

# Base URL of the Cloud Run API (no trailing slash).
# The app reads VITE_ENGINE_URL first, then falls back to VITE_API_URL.
VITE_ENGINE_URL=http://localhost:8787

# Supabase public (safe-to-expose) values for client-side auth.
# Project settings → API. Either the legacy anon JWT or a new sb_publishable_ key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional preview gate. When set, every application, marketing, and legal route
# is covered by the early-access screen. Entering the code once unlocks the full
# site in that browser. This is a presentation gate, not a security boundary:
# VITE_ values are shipped to the browser.
VITE_EARLY_ACCESS_CODE=

# Optional, DEV ONLY: start `npm run dev` already signed in, so you are not
# retyping a password all day. This is a real Supabase password sign-in, not a
# bypass, and the branch is tree-shaken out of production builds. Leave blank to
# get the normal sign-in screen. Create the account with:
#   cd server && node --env-file=.env --import tsx src/dev/claim-account.ts <email> <password>
VITE_DEV_AUTOLOGIN_EMAIL=
VITE_DEV_AUTOLOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# Server-side (server/.env) — never expose these to the browser.
# ---------------------------------------------------------------------------
# SUPABASE_URL=            # same project URL as above
# SUPABASE_ANON_KEY=       # used to verify caller access tokens
# DATABASE_URL=            # Supavisor transaction-pooler string, as forma_api.<project-ref>
#                          # E01: the deployed process refuses to start unless this
#                          # connects as forma_api on port 6543.
# DATABASE_ROLE=forma_api  # E01: mandatory startup marker; must equal the role in DATABASE_URL
# FORMA_API_SIGNING_KEY=   # E03: >=32 bytes, from Secret Manager. Signs /v1 pagination
#                          # cursors, idempotency request digests and rate-limit
#                          # subject keys. A deployed process without it refuses to
#                          # start. Generate with `openssl rand -base64 48`.
# WEB_ORIGINS=             # comma-separated CORS allowlist. Defaults to the three
#                          # production origins. "*" is refused in a deployed process.
# MAIA3_PYTHON_PATH=       # forma-maia only; CPU Python executable
# MAIA3_BRIDGE_PATH=       # persistent JSON-lines policy bridge
# MAIA3_CHECKPOINT_PATH=   # checksum-verified Maia3-5M .pt checkpoint

# Public reach baseline. The landing page's live counter adds these to the live
# row counts, to carry work the pipeline did before the database was reset.
# See server/src/players/reach.ts — read the comment there before changing them,
# and re-derive PLAYERS if you change GAMES: the ratio between the two is itself
# a claim. Set both to 0 on staging so it runs on live rows only.
# REACH_BASELINE_GAMES=500
# REACH_BASELINE_PLAYERS=10

# Billing (Stripe). Everything works without these — the API reports
# `configured: false` and the UI says billing isn't live yet. Fill them in and
# implement the two stubs in server/src/billing/service.ts to go live.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
