{
  "components": {
    "parameters": {
      "cursor": {
        "description": "Opaque signed keyset cursor bound to the route and filter set it was issued for.",
        "in": "query",
        "name": "cursor",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "limit": {
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "schemas": {
      "Problem": {
        "properties": {
          "code": {
            "enum": [
              "AUTH_REQUIRED",
              "FORBIDDEN",
              "NOT_FOUND",
              "VALIDATION_FAILED",
              "CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "IDEMPOTENCY_IN_PROGRESS",
              "PRECONDITION_REQUIRED",
              "PRECONDITION_FAILED",
              "RATE_LIMITED",
              "ENTITLEMENT_REQUIRED",
              "PROVIDER_UNAVAILABLE",
              "PROVIDER_RATE_LIMITED",
              "UNSUPPORTED_GAME",
              "INSUFFICIENT_COVERAGE",
              "WORKFLOW_NOT_CANCELLABLE",
              "INTERNAL_ERROR"
            ],
            "type": "string"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errors": {
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ],
              "type": "object"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance",
          "requestId",
          "retryable"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "supabaseBearer": {
        "bearerFormat": "JWT",
        "description": "Supabase access token. The API derives actor, profile and subject from it; a client never selects a subject.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "externalDocs": {
    "description": "Problem type registry",
    "url": "https://docs.formachess.com/problems"
  },
  "info": {
    "description": "Generated from the route registry in server/src/v1. The normative contract is plans/v1-api-contract.md; this document is checked against the implementation in CI.",
    "title": "Forma v1 API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "additionalProperties": {},
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            },
            "description": "The generated OpenAPI 3.1 document for this API"
          },
          "304": {
            "description": "The caller's copy is current."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Something went wrong"
          }
        },
        "security": [],
        "summary": "The generated OpenAPI 3.1 document for this API"
      }
    },
    "/v1/public/beta-signups": {
      "post": {
        "description": "Public command with distributed address and email abuse controls. Requires an Idempotency-Key. The response never reveals whether the address was already on the list.",
        "operationId": "createBetaSignup",
        "parameters": [
          {
            "description": "Opaque client-generated value. An identical retry replays the original response; a different request under the same key is a conflict.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "properties": {
                  "email": {
                    "format": "email",
                    "maxLength": 160,
                    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "type": "string"
                  },
                  "goal": {
                    "maxLength": 400,
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 80,
                    "minLength": 1,
                    "type": "string"
                  },
                  "platform": {
                    "enum": [
                      "lichess",
                      "chesscom",
                      "both",
                      "otb"
                    ],
                    "type": "string"
                  },
                  "ratingBand": {
                    "enum": [
                      "under-1000",
                      "1000-1400",
                      "1400-1800",
                      "1800-2200",
                      "over-2200",
                      "unrated"
                    ],
                    "type": "string"
                  },
                  "username": {
                    "maxLength": 60,
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "platform"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "additionalProperties": false,
                      "properties": {
                        "accepted": {
                          "const": true,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "accepted"
                      ],
                      "type": "object"
                    },
                    "meta": {
                      "properties": {
                        "redactions": {
                          "items": {
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "reason": {
                                "enum": [
                                  "entitlement",
                                  "projection"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "reason"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "requestId"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Join the beta testing list",
            "headers": {
              "X-Request-Id": {
                "description": "Correlates with the structured log.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request could not be accepted"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "This idempotency key was already used for a different request"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Something went wrong"
          }
        },
        "security": [],
        "summary": "Join the beta testing list"
      }
    },
    "/v1/public/plans": {
      "get": {
        "description": "Public. Prices, currency, intervals and feature copy, plus whether checkout is available. Server entitlements remain authoritative.",
        "operationId": "getPublicPlans",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "additionalProperties": false,
                      "properties": {
                        "checkoutAvailable": {
                          "type": "boolean"
                        },
                        "plans": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "currency": {
                                "const": "usd",
                                "type": "string"
                              },
                              "features": {
                                "items": {
                                  "additionalProperties": false,
                                  "properties": {
                                    "included": {
                                      "type": "boolean"
                                    },
                                    "label": {
                                      "type": "string"
                                    }
                                  },
                                  "required": [
                                    "label",
                                    "included"
                                  ],
                                  "type": "object"
                                },
                                "type": "array"
                              },
                              "id": {
                                "enum": [
                                  "free",
                                  "pro"
                                ],
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "priceMonthly": {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer"
                              },
                              "priceYearly": {
                                "maximum": 9007199254740991,
                                "minimum": -9007199254740991,
                                "type": "integer"
                              },
                              "tagline": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "tagline",
                              "priceMonthly",
                              "priceYearly",
                              "currency",
                              "features"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "required": [
                        "plans",
                        "checkoutAvailable"
                      ],
                      "type": "object"
                    },
                    "meta": {
                      "properties": {
                        "redactions": {
                          "items": {
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "reason": {
                                "enum": [
                                  "entitlement",
                                  "projection"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "reason"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "requestId"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Display plan catalogue",
            "headers": {
              "ETag": {
                "description": "Strong validator for If-None-Match.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Correlates with the structured log.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The caller's copy is current."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Something went wrong"
          }
        },
        "security": [],
        "summary": "Display plan catalogue"
      }
    },
    "/v1/public/stats": {
      "get": {
        "description": "Public. Counted from rows rather than typed in, so the figure cannot drift from the truth. No small-cell counts and no private segmentation.",
        "operationId": "getPublicStats",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "additionalProperties": false,
                      "properties": {
                        "baseline": {
                          "additionalProperties": false,
                          "properties": {
                            "games": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "players": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "players",
                            "games"
                          ],
                          "type": "object"
                        },
                        "counted": {
                          "additionalProperties": false,
                          "properties": {
                            "games": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            },
                            "players": {
                              "maximum": 9007199254740991,
                              "minimum": -9007199254740991,
                              "type": "integer"
                            }
                          },
                          "required": [
                            "players",
                            "games"
                          ],
                          "type": "object"
                        },
                        "games": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer"
                        },
                        "players": {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer"
                        },
                        "playersList": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "platform": {
                                "enum": [
                                  "lichess",
                                  "chesscom"
                                ],
                                "type": "string"
                              },
                              "username": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "username",
                              "platform"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "updatedAt": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "players",
                        "games",
                        "counted",
                        "baseline",
                        "playersList",
                        "updatedAt"
                      ],
                      "type": "object"
                    },
                    "meta": {
                      "properties": {
                        "redactions": {
                          "items": {
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "reason": {
                                "enum": [
                                  "entitlement",
                                  "projection"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "reason"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "requestId"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Approved aggregate product reach",
            "headers": {
              "ETag": {
                "description": "Strong validator for If-None-Match.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "description": "Correlates with the structured log.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The caller's copy is current."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too many requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Something went wrong"
          }
        },
        "security": [],
        "summary": "Approved aggregate product reach"
      }
    }
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://api.formachess.com"
    }
  ]
}
