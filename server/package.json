{
  "name": "@forma/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "benchmark": "tsx src/benchmark/run.ts --adapter=fixture",
    "benchmark:stockfish": "tsx src/benchmark/run.ts --adapter=stockfish",
    "benchmark:test": "tsx src/benchmark/corpus.test.ts && tsx src/benchmark/report.test.ts",
    "ingest:identity:test": "tsx src/ingest/canonical.test.ts",
    "ingest:test": "tsx src/ingest/canonical.test.ts && tsx src/ingest/pgn.test.ts && tsx src/ingest/providers.test.ts && tsx src/ingest/sync.test.ts && tsx src/analysis/phase.test.ts",
    "pipeline:test": "tsx src/security/gates/pipeline.ts",
    "cohort": "node --env-file=.env --import tsx src/players/run-cohort.ts",
    "openings:import": "tsx src/openings/import-catalogue.ts",
    "openings:test": "tsx src/openings/model.test.ts && tsx src/openings/tree.test.ts",
    "security:unit": "tsx src/security/gates/unit.ts",
    "security:migration": "tsx src/security/gates/migration.ts",
    "security:rehearsal": "tsx src/security/gates/rehearsal.ts",
    "security:production-readonly": "tsx src/security/gates/production-readonly.ts",
    "security:forbidden-scope": "tsx src/security/gates/forbidden-scope.ts",
    "platform:unit": "tsx src/platform/connection.test.ts",
    "platform:database": "tsx src/platform/gates/database.ts",
    "v1:unit": "tsx src/v1/kernel.test.ts",
    "v1:openapi": "tsx src/v1/gates/openapi.ts",
    "v1:openapi:check": "tsx src/v1/gates/openapi.ts --check",
    "v1:integration": "tsx src/v1/gates/integration.ts",
    "v1:security": "tsx src/v1/gates/security.ts",
    "v1:migration": "tsx src/v1/gates/migration.ts",
    "v1:performance": "tsx src/v1/gates/performance.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.0",
    "@hono/node-server": "^2.0.8",
    "@supabase/supabase-js": "^2.110.5",
    "chess.js": "^1.4.0",
    "chessops": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "jose": "^6.2.9",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
